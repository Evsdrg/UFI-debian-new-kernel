# 本仓库只跟踪“项目自身的工作”：脚本、文档、DTS、配置、补丁、清单。
# 大体积产物与上游参考树不入版本库（见 README.md 的目录说明）。

# ==== 源码与上游参考（可从上游重新获取）====
# 通配所有内核树：升级内核（6.18.49 -> 7.1.13 -> ...）时不必再改这里。
# 当前使用哪个版本由 source/kernel-version.env 决定。
/source/linux-*/
/upstream/

# ==== 工具链与刷机工具（体积大、可重下）====
/edl-tools/
/mkbootimg/

# ==== 产物与中间态（可用 tools/ 下的脚本重建）====
# 所有构建产物集中在 artifacts/（唯一位位置，见 artifacts/README.md）。
# 大体积产物与构建输入不入库；小体积的产物元数据（*-build.json）与
# 板型 DTB 例外入库，供追溯与离线核对。
/artifacts/rootfs/
/artifacts/modules/
/artifacts/firmware/
/artifacts/boot/*/*.img
# Image.gz + DTB 的拼接中间产物，可由内核镜像与 DTS 重建
/artifacts/boot/*/kernel-*-dtb
/artifacts/boot/*/empty-ramdisk
/build/
/out/

# ==== 不可再生但体积大：备份与刷机证据（仅在本地保留）====
# 注意：用 /dir/* 排除内容而不是 /dir/ 排除目录本身，否则无法用 ! 重新包含子路径。
/recovery/*
!/recovery/logs/
/recovery/logs/*
# 例外：小体积的文本证据值得入库（可追溯），如 fastboot 实测串口日志
!/recovery/logs/fastboot-test-serial-*.log
/archive/

# ==== Python ====
__pycache__/
*.pyc

# ==== 编辑器 / 系统 ====
.vscode/
.idea/
*.swp
*~
.DS_Store

# ==== 内核编译产物（若在树内就地构建）====
*.o
*.o.d
*.a
*.s
*.ko
*.cmd
*.mod
*.mod.c
*.order
*.symvers
*.ll
*.c.[0-9]*
.tmp_versions/
modules.order
modules.builtin
modules.builtin.modinfo
.wifi-creds

# 嵌套的分发仓，自带 git，不进本仓
/ufi00x-mainline/
.local-creds
.wifi-creds

# ==== 仅本地保留、不随仓库发布的文档与资产 ====
# 内部作业手册（贡献者请读 CONTRIBUTING.md）
/AGENTS.md
# 已被后续验收取代的首轮验证记录
/docs/validation/VALIDATION-7.2.9.md
# 内部清理史与内部调研（公开的 CHANGES.md / ISSUES.md 只留公开部分）
/CLEANUP-HISTORY.md
/ISSUES-LOCAL.md
# MF32（未 bring-up 的第三方板，无产物、无硬件，内部逆向资料）
/boards/thwc-mf32/
/tools/mf32-*
# 内部构建辅助素材（非构建依赖，各主机自备）：
# arch-test-arm64 是宿主缺 arm64 探针时的临时补齐件（见 CONTRIBUTING.md §3）
/tools/toolchain/
# debs/ 是当年调试 rootfs 启动时手工攒的增量包（kmod/udev/regdb），
# 已沉淀为 build-rootfs.sh 的正式实现，脚本不再引用
/tools/debs/
