[Unit]
Description=Native USB sharing: supervised DHCP/DNS and scoped NAT
Requires=systemd-networkd.service
BindsTo=usb-gadget.service
After=usb-gadget.service systemd-networkd.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file=/etc/dnsmasq.d/usb-share.conf
ExecStartPre=/usr/local/sbin/usb-share-native.sh start
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/dnsmasq.d/usb-share.conf --pid-file=/run/dnsmasq-usb.pid
ExecStopPost=/usr/local/sbin/usb-share-native.sh stop
Restart=on-failure
RestartSec=3
TimeoutStartSec=40
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
