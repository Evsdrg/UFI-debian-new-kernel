#!/usr/sbin/nft -f
# 仅管理自己的表，整批替换，重复 start 不叠加规则；不 flush 全局 ruleset。
add table inet openstick_usb
flush table inet openstick_usb
table inet openstick_usb {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        iifname "usb0" ip saddr 10.42.0.0/24 oifname != "usb0" masquerade
    }
    chain forward {
        type filter hook forward priority filter; policy accept;
        oifname "usb0" ip daddr 10.42.0.0/24 ct state { established, related } accept
        iifname "usb0" ip saddr 10.42.0.0/24 accept
        iifname "usb0" reject
        oifname "usb0" reject
    }
}
