# Common rootfs profile
# Set ROOTFS_PROFILE to a file containing site/board-specific provisioning values.
# The default profile intentionally contains no Wi-Fi password or root password.
ROOTFS_HOSTNAME=${ROOTFS_HOSTNAME:-openstick}
ROOTFS_WIFI_SSID=${ROOTFS_WIFI_SSID:-}
ROOTFS_WIFI_PSK=${ROOTFS_WIFI_PSK:-}
ROOTFS_ROOT_PASSWORD_HASH=${ROOTFS_ROOT_PASSWORD_HASH:-}
ROOTFS_ROOT_PARTUUID=${ROOTFS_ROOT_PARTUUID:-}
