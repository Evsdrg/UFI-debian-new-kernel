+/*
+ * Runtime firmware-config knob.  Writing "<cfg_id> <value>" (either decimal or
+ * 0x-prefixed) pushes one WCN36XX_HAL_CFG_* value to the firmware through the
+ * same HAL update-cfg request the driver already uses for the RTS threshold.
+ *
+ * This exists because the firmware owns TX rate adaptation on this chip
+ * (IEEE80211_HW_HAS_RATE_CONTROL) and the driver only sends its config table at
+ * start time, so there is otherwise no way to observe the effect of a rate or
+ * retry parameter without rebuilding and rebooting.  Reading the file prints the
+ * raw value handed to the HAL with no interpretation.
+ */
+static ssize_t read_file_cfg(struct file *file, char __user *user_buf,
+			     size_t count, loff_t *ppos)
+{
+	struct wcn36xx *wcn = file->private_data;
+	char buf[64];
+	int len;
+
+	len = scnprintf(buf, sizeof(buf), "last_cfg_id=%u last_cfg_value=%u\n",
+			wcn->dfs_last_cfg_id, wcn->dfs_last_cfg_value);
+
+	return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+static ssize_t write_file_cfg(struct file *file, const char __user *user_buf,
+			      size_t count, loff_t *ppos)
+{
+	struct wcn36xx *wcn = file->private_data;
+	char buf[64], *sep;
+	unsigned long id, value = 0;
+	ssize_t len;
+	int ret;
+
+	len = min_t(size_t, count, sizeof(buf) - 1);
+	if (copy_from_user(buf, user_buf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	/*
+	 * Expect "id" or "id value".  Split the two tokens explicitly: kstrtoul()
+	 * wants a bare number, so the separator has to be terminated here.
+	 */
+	sep = strpbrk(buf, " \t");
+	if (sep)
+		*sep++ = '\0';
+
+	ret = kstrtoul(buf, 0, &id);
+	if (ret)
+		return ret;
+
+	if (sep) {
+		while (*sep == ' ' || *sep == '\t')
+			sep++;
+		if (*sep) {
+			ret = kstrtoul(sep, 0, &value);
+			if (ret)
+				return ret;
+		}
+	}
+
+	ret = wcn36xx_smd_update_cfg(wcn, (u32)id, (u32)value);
+	if (ret) {
+		wcn36xx_err("cfg write failed: id=%lu value=%lu ret=%d\n",
+			    id, value, ret);
+		return ret;
+	}
+
+	wcn->dfs_last_cfg_id = (u32)id;
+	wcn->dfs_last_cfg_value = (u32)value;
+	wcn36xx_info("cfg write: id=%lu value=%lu\n", id, value);
+
+	return count;
+}
+
+static const struct file_operations fops_wcn36xx_cfg = {
+	.open = simple_open,
+	.read = read_file_cfg,
+	.write = write_file_cfg,
+};
+
