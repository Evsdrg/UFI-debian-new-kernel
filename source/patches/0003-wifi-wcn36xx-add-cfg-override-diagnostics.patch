+/*
+ * Override any WCN36XX_HAL_CFG_* value handed to the firmware at MAC start, as
+ * a comma-separated list of "id=value" pairs (decimal or 0x-prefixed), e.g.
+ * "9=20000".  The firmware latches its configuration when the MAC starts, so a
+ * runtime update-cfg request is accepted but has no effect: after changing this
+ * the link has to be re-started (ip link down/up) for it to take effect.
+ *
+ * This exists because the rate the firmware actually transmits at is not
+ * settable from the host -- it does not honour WCN36XX_HAL_CFG_FIXED_RATE for HT
+ * rates at all -- so behavioural knobs like MAX_MEDIUM_TIME can only be probed
+ * this way.
+ */
+char *wcn36xx_cfg_override;
+module_param_named(cfg_override, wcn36xx_cfg_override, charp, 0644);
+MODULE_PARM_DESC(cfg_override, "Comma-separated firmware cfg overrides, e.g. \"9=20000\"");
