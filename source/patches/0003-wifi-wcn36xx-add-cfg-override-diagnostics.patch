+/*
+ * Look up an override for one config id in the wcn36xx_cfg_override module
+ * parameter ("id=value,id=value,...").  Returns the replacement value, or the
+ * caller's value unchanged when there is no match.
+ */
+static u32 wcn36xx_cfg_lookup_override(u32 id, u32 value)
+{
+	const char *p;
+
+	if (!wcn36xx_cfg_override || !*wcn36xx_cfg_override)
+		return value;
+
+	p = wcn36xx_cfg_override;
+	while (*p) {
+		char token[32];
+		const char *comma;
+		char *eq;
+		size_t tlen;
+		unsigned long oid, oval;
+
+		comma = strchrnul(p, ',');
+		tlen = comma - p;
+		if (tlen == 0 || tlen >= sizeof(token)) {
+			p = *comma ? comma + 1 : comma;
+			continue;
+		}
+		memcpy(token, p, tlen);
+		token[tlen] = '\0';
+		p = *comma ? comma + 1 : comma;
+
+		/* An entry is "id=value"; a bare "id" means value 0. */
+		eq = strchr(token, '=');
+		if (eq)
+			*eq++ = '\0';
+
+		if (kstrtoul(token, 0, &oid))
+			continue;
+		if (oid != id)
+			continue;
+
+		oval = 0;
+		if (eq && kstrtoul(eq, 0, &oval))
+			continue;
+
+		return (u32)oval;
+	}
+
+	return value;
+}
