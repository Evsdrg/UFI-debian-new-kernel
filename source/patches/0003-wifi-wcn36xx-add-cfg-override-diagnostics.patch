-				      cfg_vals[i].value);
+		u32 cfg_id = cfg_vals[i].cfg_id;
+		u32 cfg_value = cfg_vals[i].value;
+
+		/* Diagnostic override; see the cfg_override comment in main.c. */
+		cfg_value = wcn36xx_cfg_lookup_override(cfg_id, cfg_value);
+
+		if (cfg_value != cfg_vals[i].value)
+			wcn36xx_info("cfg override: id=%u value=%u (table %u)\n",
+				     cfg_id, cfg_value, cfg_vals[i].value);
+
