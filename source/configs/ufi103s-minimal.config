# UFI103s 最简功能内核（minimal）—— 内存最大化
#
# 目标：只保留三条功能链，其余全部关掉，把内核常驻内存和模块数压到最低：
#   1. 基础 WiFi  —— cfg80211 / mac80211 / wcn36xx + WCNSS PIL 链
#   2. USB 网络共享 —— gadget + configfs + RNDIS + nftables NAT
#   3. 内存压缩    —— zram + zsmalloc + zstd
#
# 另需保留的"起不来就白搭"项：eMMC（MMC_SDHCI_MSM）、ext4 根文件系统、
# pinctrl/clk/regulator/thermal 的 msm8916 部分、电源键与 LED。
#
# 用法（叠加在 common-<ver>-os.config + ufi103s-baseline 之上）：
#   tools/build-kernel-variant.sh minimal \
#       source/configs/ufi103s-minimal.config <modules-dest>
#
# 合并语义：只用 CONFIG_X=n / =y 赋值行，不用 "# CONFIG_X is not set"
# 注释行 —— merge_config.sh 对与基础配置冲突的注释行会整行吞掉。
#
# 注意：olddefconfig 会把被 select 的项自动拉回来（例如 MTD_NAND_QCOM 被
# NAND core select、UFS 被 SCSI select），所以这里的 =n 只对"用户可选"项
# 有效；被 select 的必须先把它的 selecter 关掉。

# ─────────────────────────── 1. 存储：只留 eMMC ───────────────────────────
# 本机只有 eMMC（mmcblk0），没有 SCSI/UFS/NVMe/ATA/MTD/NAND/SPI-NOR。
CONFIG_MTD=n
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_BLK_DEV_SD=n
CONFIG_UFS_FS=n
CONFIG_NVME_CORE=n
CONFIG_BLK_DEV_NVME=n

# 上层要一并关，否则 olddefconfig 会把下层重新打开
CONFIG_SCSI_MOD=n
CONFIG_SCSI_COMMON=n
CONFIG_SCSI_DMA=n
CONFIG_SCSI_LOWLEVEL=n
CONFIG_SCSI_UFSHCD=n
CONFIG_SCSI_UFS_BSG=n
CONFIG_SCSI_UFSHCD_PLATFORM=n
CONFIG_SCSI_SAS_ATTRS=n
CONFIG_SCSI_SAS_LIBSAS=n
CONFIG_SCSI_SAS_ATA=n
CONFIG_SCSI_SAS_HOST_SMP=n
CONFIG_SCSI_HISI_SAS=n
CONFIG_ATA_SFF=n
CONFIG_ATA_BMDMA=n
CONFIG_ATA_VERBOSE_ERROR=n
CONFIG_ATA_FORCE=n
CONFIG_BLK_DEV_BSG=n

# ───────────────────── 2. 其它 SoC 的平台驱动（本机是 MSM8916）─────────────────────
# PINCTRL / INTERCONNECT / CLK 里的高通车系其它平台条目，全部 =y 内建在核心里，
# 对 msm8916 是纯浪费的常驻 code/rodata。
CONFIG_PINCTRL_MSM8994=n
CONFIG_PINCTRL_MSM8996=n
CONFIG_PINCTRL_MSM8998=n
CONFIG_PINCTRL_MSM8953=n
CONFIG_PINCTRL_MSM8976=n
CONFIG_PINCTRL_QCM2290=n
CONFIG_PINCTRL_QCS404=n
CONFIG_PINCTRL_QCS615=n
CONFIG_PINCTRL_QCS8300=n
CONFIG_PINCTRL_QDU1000=n
CONFIG_PINCTRL_SA8775P=n
CONFIG_PINCTRL_SC7180=n
CONFIG_PINCTRL_SC7280=n
CONFIG_PINCTRL_SC8180X=n
CONFIG_PINCTRL_SC8280XP=n
CONFIG_PINCTRL_SDM845=n
CONFIG_PINCTRL_SDX75=n
CONFIG_PINCTRL_SM6115=n
CONFIG_PINCTRL_SM8150=n
CONFIG_PINCTRL_SM8250=n
CONFIG_PINCTRL_SM8350=n
CONFIG_PINCTRL_SM8450=n
CONFIG_PINCTRL_SM8550=n
CONFIG_PINCTRL_SM8650=n
CONFIG_PINCTRL_SM8750=n
CONFIG_PINCTRL_X1E80100=n

CONFIG_INTERCONNECT_QCOM_MSM8996=n
CONFIG_INTERCONNECT_QCOM_QCM2290=n
CONFIG_INTERCONNECT_QCOM_QCS404=n
CONFIG_INTERCONNECT_QCOM_QCS615=n
CONFIG_INTERCONNECT_QCOM_QCS8300=n
CONFIG_INTERCONNECT_QCOM_QDU1000=n
CONFIG_INTERCONNECT_QCOM_SA8775P=n
CONFIG_INTERCONNECT_QCOM_SC7180=n
CONFIG_INTERCONNECT_QCOM_SC7280=n
CONFIG_INTERCONNECT_QCOM_SC8180X=n
CONFIG_INTERCONNECT_QCOM_SC8280XP=n
CONFIG_INTERCONNECT_QCOM_SDM845=n
CONFIG_INTERCONNECT_QCOM_SDX75=n
CONFIG_INTERCONNECT_QCOM_SM6115=n
CONFIG_INTERCONNECT_QCOM_SM8150=n
CONFIG_INTERCONNECT_QCOM_SM8250=n
CONFIG_INTERCONNECT_QCOM_SM8350=n
CONFIG_INTERCONNECT_QCOM_SM8450=n
CONFIG_INTERCONNECT_QCOM_SM8550=n
CONFIG_INTERCONNECT_QCOM_SM8650=n
CONFIG_INTERCONNECT_QCOM_SM8750=n
CONFIG_INTERCONNECT_QCOM_X1E80100=n

CONFIG_QCOM_CLK_APCC_MSM8996=n
CONFIG_MSM_GCC_8994=n
CONFIG_MSM_GCC_8996=n
CONFIG_MSM_GCC_8998=n
CONFIG_MSM_MMCC_8994=n
CONFIG_MSM_MMCC_8996=n
CONFIG_MSM_MMCC_8998=n
CONFIG_QCOM_HIDMA=n
CONFIG_QCOM_HIDMA_MGMT=n
CONFIG_QCOM_LLCC=n
CONFIG_QCOM_OCMEM=n
# 注意：QCOM_APCS_IPC 绝对不能关。它是 msm8916 的 APCS IPC mailbox 驱动，
# 而 QCOM_CLK_APCS_MSM8916（msm8916 的 CPU 时钟控制器，管 CPU 频率）
# depends on QCOM_APCS_IPC。关掉它会让 CPU 时钟驱动整个符号消失，内核在
# 早期 CPU 频率初始化时硬挂死（无 panic、无任何输出，只能物理断电）。
# 2026-10-17 实测：QEMU 无 APCS 硬件故能启动，掩盖了该缺陷。
CONFIG_QCOM_APCS_IPC=y
CONFIG_QCOM_CPUCP_MBOX=n
CONFIG_QCOM_APR=n

# ───────────────────────── 3. 文件系统：只留 ext4 ─────────────────────────
# 根文件系统是 ext4；其余（网络文件系统、只读镜像、FAT 等）一律不要。
CONFIG_BTRFS_FS=n
CONFIG_NFS_FS=n
CONFIG_NFS_V2=n
CONFIG_NFS_V3=n
CONFIG_NFS_V4=n
CONFIG_NFS_COMMON=n
CONFIG_9P_FS=n
CONFIG_CIFS=n
CONFIG_SMB_SERVER=n
CONFIG_ISO9660_FS=n
CONFIG_UDF_FS=n
CONFIG_FAT_FS=n
CONFIG_VFAT_FS=n
CONFIG_MSDOS_FS=n
CONFIG_NTFS3_FS=n
CONFIG_NTFS_FS=n
CONFIG_JFS_FS=n
CONFIG_GFS2_FS=n
CONFIG_OCFS2_FS=n
CONFIG_REISERFS_FS=n
CONFIG_EXFAT_FS=n
CONFIG_SQUASHFS=n
CONFIG_EROFS_FS=n
CONFIG_XFS_FS=n
CONFIG_FUSE_FS=n
CONFIG_OVERLAY_FS=n

# ─────────────────── 4. 无关网络协议与总线（保留 ipv4/ipv6/nftables）───────────────────
CONFIG_SCTP=n
CONFIG_DCCP=n
CONFIG_RDS=n
CONFIG_TIPC=n
CONFIG_CAN=n
CONFIG_NFC=n
CONFIG_BATMAN_ADV=n
CONFIG_OPENVSWITCH=n
CONFIG_VSOCKETS=n
CONFIG_XFRM_USER=n
CONFIG_NET_SCHED=n
CONFIG_NET_CLS_ACT=n
CONFIG_NET_EMATCH=n

# ───────────────────── 5. 无线：只留 WCN36XX，去掉其它厂商 ─────────────────────
# 注意：wcn36xx 之后由板型片段打开，这里只关"别家网卡驱动"。
# 注意：wcn36xx 在 drivers/net/wireless/ath/ 下，受 WLAN_VENDOR_ATH 控制，
# 所以 ATH vendor 必须保留 =y，只关掉它内部用不到的驱动。
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_BROADCOM=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_ADMTEK=n
# ATH vendor 保留，内部只留 wcn36xx：
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=n
CONFIG_ATH9K_HTC=n
CONFIG_CARL9170=n
CONFIG_ATH6KL=n
CONFIG_AR5523=n
CONFIG_WIL6210=n
CONFIG_ATH10K=n
CONFIG_ATH10K_PCI=n
CONFIG_ATH10K_AHB=n
CONFIG_ATH10K_SDIO=n
CONFIG_ATH10K_USB=n
CONFIG_ATH11K=n
CONFIG_ATH11K_AHB=n
CONFIG_ATH11K_PCI=n
CONFIG_ATH12K=n

# ───────────────────────── 6. 蓝牙 / 输入 / 其它外设 ─────────────────────────
# 本变体定位"仅 WiFi + USB 共享"，蓝牙内核侧一并关掉（rootfs 里的 bluez
# 会因缺 hci 设备而空转，属预期；要蓝牙请用其它板型）。
CONFIG_BT=n
CONFIG_BT_HCIVHCI=n
CONFIG_BT_HCIUART=n
CONFIG_BT_QCOMSMD=n
CONFIG_RFKILL=n

# 输入：只保留电源键（长按断电靠它），其余触摸/摇杆/键盘鼠标全关。
# 注意 PM8941_PWRKEY 在 INPUT_MISC 菜单内，所以 INPUT_MISC 必须保留 =y。
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_PM8XXX_VIBRATOR=n
CONFIG_INPUT_TPS65219_PWRBUTTON=n
CONFIG_INPUT_PWM_BEEPER=n
CONFIG_INPUT_PWM_VIBRA=n
CONFIG_INPUT_RK805_PWRKEY=n
CONFIG_INPUT_DA9063_ONKEY=n
CONFIG_HID=n
CONFIG_HID_GENERIC=n
CONFIG_USB_HID=n
# 键盘子系统必须保留：DTS 的 gpio-keys（"Reset" 键，linux,code=KEY_RESTART）
# 需要 CONFIG_KEYBOARD_GPIO，而它在 `if INPUT_KEYBOARD` 内——关掉
# INPUT_KEYBOARD 会把 Reset 按键整个切掉（设备失去唯一物理按键）。
# 2026-10-17 实测：INPUT_KEYBOARD=n 时只剩 pm8941_pwrkey，gpio-keys 不枚举。
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
# 其余键盘/鼠标/摇杆驱动全关，只留 GPIO 按键。
CONFIG_KEYBOARD_ATKBD=n
CONFIG_KEYBOARD_GPIO_POLLED=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n

# ───────────────────────── 7. 无用总线与多媒体 ─────────────────────────
CONFIG_MEDIA_SUPPORT=n
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_FB=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_IIO=n
CONFIG_W1=n
CONFIG_GPIO_GENERIC_PLATFORM=n

# PWM 不能关：状态灯驱动 LEDS_QCOM_LPG（msm8916 三色灯）depends on PWM，
# 关掉 PWM 会让设备失去唯一的状态指示。保留 PWM 与 LPG 驱动。
CONFIG_PWM=y
CONFIG_PWM_SYSFS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_QCOM_LPG=m
CONFIG_QCOM_PBS=m

# ───────────────────────── 8. 调试与跟踪（省常驻）─────────────────────────
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_MISC=n
CONFIG_RCU_TRACE=n
CONFIG_TRACE_CLOCK=n
CONFIG_FTRACE=n
CONFIG_FUNCTION_TRACER=n
CONFIG_KPROBES=n
CONFIG_UPROBES=n
CONFIG_CORESIGHT=n
CONFIG_MEMTEST=n
CONFIG_MAGIC_SYSRQ=n

# 内核符号表（KALLSYMS）在 rodata 里占相当一块，且提示词挂在 EXPERT 下——
# EXPERT=n 时符号被强制 default y、无视任何用户值，所以必须一起开 EXPERT
# 才关得掉（与 kernel-size.config 同一条经验，2026-09-15 实测 -1.13MB raw rodata）。
# 代价：oops 只剩裸地址，没有符号名。
CONFIG_EXPERT=y
CONFIG_KALLSYMS=n
