# THWC MF601SL_CT_V07（mf601sl_v07）—— MSM8916 电池型 4G MiFi
#
# 与 UFI103s 的差别只在硬件外设：4G 链与 WiFi 链沿用 common-7.2.9-os.config
# 里已有的配置（QCOM_Q6V5_MSS / QCOM_BAM_DMUX / WWAN / RPMSG_WWAN_CTRL /
# QRTR / QRTR_SMD / QCOM_QMI_HELPERS / QCOM_RMTFS_MEM 均已 =m），这里只补
# 电池机独有的两项。
#
# 为什么 LBC 必须开：pm8916_lbc 除了充电，还注册 EXTCON_USB，MF601 的 USB
# device 模式由充电器的 VBUS 检测决定。只开电量计不开 LBC，会出现“电池有
# 读数但插电脑没有 RNDIS”。（UFI 走 extcon-usb-gpio，机制不同，不能照搬。）
CONFIG_CHARGER_PM8916_LBC=m
CONFIG_BATTERY_PM8916_BMS_VM=m

# BMS 走 SPMI VADC 读电压；VADC 已在 common 里 =m，这里显式确认不裁掉。
CONFIG_QCOM_SPMI_VADC=m

# 电量计/充电的上层依赖
CONFIG_POWER_SUPPLY=y
CONFIG_EXTCON=y

# 震动器（SL 参考树启用了 vibrator@c000；硬件存在就留着，代价极小）
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PM8XXX_VIBRATOR=y

# 不开 venus（硬件编解码）：MF601SL 是电池型 4G MiFi，不做推流/转码；
# SL 参考树启用了它，但那会多占 5MB venus_mem 预留与功耗。
# 需要硬编解码时叠加 source/configs/ufi103s-venus.config 重新构建即可。

# SD 卡槽（MF601 有 microSD，UFI 没有）
CONFIG_MMC_SDHCI_MSM=y
