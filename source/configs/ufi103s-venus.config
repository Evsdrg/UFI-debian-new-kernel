# UFI103s hardware video codec (Qualcomm Venus) variant
# Applied on top of source/configs/common-6.18.49-os.config.
#
# Venus is a V4L2 memory-to-memory codec: it needs the media/V4L2 core but
# NOT DRM or the Adreno GPU. This is a headless board, so no display stack.

# --- Media / V4L2 core ---
CONFIG_MEDIA_SUPPORT=y
# MEDIA_SUPPORT_FILTER defaults to y without EXPERT, which hides platform
# codecs behind this prompt; select it explicitly.
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_MEM2MEM_DRIVERS=y

# --- Qualcomm Venus accelerator (MSM8916) ---
# Selects VIDEOBUF2_DMA_CONTIG, V4L2_MEM2MEM_DEV, QCOM_MDT_LOADER, QCOM_SCM.
CONFIG_VIDEO_QCOM_VENUS=m

# --- Distinct release string: keeps this variant's modules isolated from
#     the baseline 6.18.49-ufi003-dirty tree. ---
CONFIG_LOCALVERSION="-ufi003-venus"

# --- WiFi observability ---
# The wcn36xx TX rate is owned by the firmware, and diagnosing a stuck low TX
# MCS needs these debugfs views (station agg_status, driver cfg/feat-caps
# entries).  They are read/write diagnostics only; the actual fix for the TX
# throughput problem is in the driver source (MAX_MEDIUM_TIME), not here.
CONFIG_DEBUG_FS=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_WCN36XX_DEBUGFS=y
