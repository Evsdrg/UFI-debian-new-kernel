# Observation-only fragment: exports mac80211/cfg80211/wcn36xx internals in
# debugfs so a live station can be inspected (TX aggregation status, firmware
# feature-caps bitmap).  No functional change to the driver's behaviour.
CONFIG_DEBUG_FS=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_WCN36XX_DEBUGFS=y
