# THWC MF32（MF32_MB_V02）板级配置
# 在 common-7.2.9-os.config 上叠加。
# MF32 是电池型 4G MiFi：完整保留 modem/4G，不套用 baseline/minimal 的内存裁剪。

# 电池充电与电量计
CONFIG_CHARGER_PM8916_LBC=m
CONFIG_BATTERY_PM8916_BMS_VM=m

# 震动马达（DTS 中 pm8916-vib 已启用）
CONFIG_INPUT_PM8XXX_VIBRATOR=y

# 本版不启用 Venus：设备树同时关闭 video-codec 与 venus 预留内存。
# 需要硬编解码时应把 venus 预留提高到至少 5MB，并另行验证，不能直接沿用原厂 1MB。
