# UFI103s / msm8916 fragment on top of arch/arm64/configs/defconfig
# Goal: boot + Wi-Fi STA + 4G data/SMS USB stick. No display, no other SoCs.

CONFIG_LOCALVERSION="-ufi003"
# CONFIG_LOCALVERSION_AUTO is not set

# Keep only Qualcomm
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# Stick is DT + PSCI, not EFI/ACPI
# CONFIG_EFI is not set
# CONFIG_ACPI is not set

# No panel on this stick
# CONFIG_DRM_MSM is not set
# CONFIG_DRM is not set

# Shrink build artifacts
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set

# Wi-Fi: WCN3620 only
# CONFIG_ATH10K is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH12K is not set
# CONFIG_ATH9K is not set
# CONFIG_IWLWIFI is not set
# CONFIG_MWIFIEX is not set
# CONFIG_BRCMFMAC is not set
# CONFIG_RTLWIFI is not set
# CONFIG_MT76 is not set

# NAT for optional USB tethering / 4G sharing (nftables only, no iptables-legacy)
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
# CONFIG_IP_NF_IPTABLES is not set

# No onboard speaker/headphone: drop MSM8916 analog/digital codec and LPASS
# CONFIG_SND_SOC_MSM8916_WCD_ANALOG is not set
# CONFIG_SND_SOC_MSM8916_WCD_DIGITAL is not set
# CONFIG_SND_SOC_APQ8016_SBC is not set
# CONFIG_SND_SOC_LPASS_APQ8016 is not set
# CONFIG_SND_SOC_SC7180 is not set
# CONFIG_SND_SOC_SC7280 is not set
# CONFIG_SND_SOC_LPASS_SC7180 is not set
# CONFIG_SND_SOC_LPASS_SC7280 is not set
# CONFIG_SND_SOC_LPASS_CPU is not set
# CONFIG_SND_SOC_LPASS_PLATFORM is not set
# CONFIG_SND_SOC_LPASS_HDMI is not set
# CONFIG_SND_SOC_LPASS_CDC_DMA is not set
# CONFIG_SND_SOC_BT_SCO is not set
# CONFIG_SND_SOC_MSM8996 is not set
# CONFIG_SND_SOC_SDM845 is not set
# CONFIG_SND_SOC_SM8250 is not set
# CONFIG_SND_SOC_SC8280XP is not set
# CONFIG_SND_SOC_QCOM_SDW is not set
# CONFIG_SND_SOC_LPASS_WSA_MACRO is not set
# CONFIG_SND_SOC_LPASS_VA_MACRO is not set
# CONFIG_SND_SOC_LPASS_RX_MACRO is not set
# CONFIG_SND_SOC_LPASS_TX_MACRO is not set
# Stick has no analog codec; A2DP is userspace. Drop remaining QCOM ASoC.
# CONFIG_SND_SOC_QCOM is not set
# CONFIG_SND_SOC_WCD9335 is not set
# CONFIG_SND_SOC_WCD934X is not set
# CONFIG_SND_SOC_WCD938X is not set
# CONFIG_SND_SOC_WCD939X is not set
# CONFIG_SND_SOC_WSA881X is not set
# CONFIG_SND_SOC_WSA883X is not set
# CONFIG_SND_SOC_WSA884X is not set
# CONFIG_SND_SOC_WCD938X_SDW is not set
# CONFIG_SND_SOC_WCD939X_SDW is not set
# CONFIG_SOUNDWIRE_QCOM is not set

# zram swap: 461MB RAM, prefer zstd over lzo (CPU for better ratio)
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
# CONFIG_ZRAM_BACKEND_LZO is not set
# CONFIG_ZRAM_BACKEND_LZ4 is not set
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# Board drivers that defconfig left modular/off
CONFIG_QCOM_BAM_DMUX=m
CONFIG_EXTCON_USB_GPIO=m
CONFIG_WCN36XX=m
CONFIG_BT_QCOMSMD=m
CONFIG_QCOM_WCNSS_PIL=m
CONFIG_QCOM_WCNSS_CTRL=m
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QCOM_RMTFS_MEM=m
