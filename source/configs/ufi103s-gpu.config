# Qualcomm Adreno 306 GPU（render-only，不启用显示）
#
# MSM8916 的 GPU 是 Adreno 306（主线 a3xx 家族，chip_id 0x03000600），
# 固件 a300_pfp.fw / a300_pm4.fw 已在镜像的 /lib/firmware/qcom/ 里。
#
# 这些设备是无显示的 U 盘形态（没有 MIPI DSI 面板、没有 HDMI），所以只要
# GPU 的 **render 节点**，不要 KMS/显示。做法是让 CONFIG_DRM_MSM_KMS 保持 n：
# 驱动在无显示组件时会走 msm_gpu_probe() 单独注册 DRM render 设备，条件是
# 模块参数 separate_gpu_kms=1（见 msm_drv.c 的 msm_gpu_no_components()）。
#
# 关键：MDP4 / MDP5 / DPU 在 Kconfig 里是 "default y"，olddefconfig 会自动
# 打开它们，而它们各自 select DRM_MSM_KMS —— 于是 KMS 被强制启用，驱动转去
# 找显示组件并失败。所以这里**必须显式 =n** 才能得到 render-only。
CONFIG_DRM=m
CONFIG_DRM_MSM=m

# 关掉所有显示后端（保持 DRM_MSM_KMS=n）
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_MDP5 is not set
# CONFIG_DRM_MSM_DPU is not set
# CONFIG_DRM_MSM_MDSS is not set
# CONFIG_DRM_MSM_DSI is not set
# CONFIG_DRM_MSM_DP is not set
# CONFIG_DRM_MSM_HDMI is not set

# 没有 KMS 也就不需要 fbdev 模拟
# CONFIG_DRM_FBDEV_EMULATION is not set

# GPU 状态转储走 debugfs，便于排错（DEBUG_FS 已在主配置启用）
CONFIG_DRM_MSM_GPU_STATE=y

# 与 ufi103s-venus.config 里的设置一致。板型构建会用更细的后缀覆盖这一行。
CONFIG_LOCALVERSION="-ufix0x-venus"
