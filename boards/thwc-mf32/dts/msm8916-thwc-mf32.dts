				vddpa-supply = <0xa3>;
				vdddig-supply = <0x5c>;
				compatible = "qcom,wcn3620";
			};

			smd-edge {
				interrupts = <0x00 0x8e 0x01>;
				qcom,ipc = <0x05 0x08 0x11>;
				qcom,smd-edge = <0x06>;
				qcom,remote-pid = <0x04>;
				label = "pronto";

				wcnss {
					compatible = "qcom,wcnss";
					qcom,smd-channels = "WCNSS_CTRL";
					qcom,mmio = <0xa4>;

					bluetooth {
						compatible = "qcom,wcnss-bt";
					};

					wifi {
						compatible = "qcom,wcnss-wlan";
						interrupts = <0x00 0x91 0x04 0x00 0x92 0x04>;
						interrupt-names = "tx", "rx";
						qcom,smem-states = <0x66 0x0a 0x66 0x09>;
						qcom,smem-state-names = "tx-enable", "tx-rings-empty";
					};
				};
			};
		};

		p1: interrupt-controller@b000000 {
			compatible = "qcom,msm-qgic2";
			interrupt-controller;
			#interrupt-cells = <0x03>;
			reg = <0xb000000 0x1000 0xb002000 0x2000 0xb001000 0x1000 0xb004000 0x2000>;
			interrupts = <0x01 0x00 0xf04>;
			phandle = <0x01>;
		};

		p5: mailbox@b011000 {
			compatible = "qcom,msm8916-apcs-kpss-global", "syscon";
			reg = <0xb011000 0x1000>;
			#mbox-cells = <0x01>;
			clocks = <&pa5 &p13 0x01>;
			clock-names = "pll", "aux";
			#clock-cells = <0x00>;
			phandle = <0x05>;
		};

		pa5: clock@b016000 {
			compatible = "qcom,msm8916-a53pll";
			reg = <0xb016000 0x40>;
			#clock-cells = <0x00>;
			clocks = <&p1b>;
			clock-names = "xo";
			phandle = <0xa5>;
		};

		timer@b020000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			compatible = "arm,armv7-timer-mem";
			reg = <0xb020000 0x1000>;
			clock-frequency = <0x124f800>;

			frame@b021000 {
				frame-number = <0x00>;
				interrupts = <0x00 0x08 0x04 0x00 0x07 0x04>;
				reg = <0xb021000 0x1000 0xb022000 0x1000>;
			};

			frame@b023000 {
				frame-number = <0x01>;
				interrupts = <0x00 0x09 0x04>;
				reg = <0xb023000 0x1000>;
				status = "disabled";
			};

			frame@b024000 {
				frame-number = <0x02>;
				interrupts = <0x00 0x0a 0x04>;
				reg = <0xb024000 0x1000>;
				status = "disabled";
			};

			frame@b025000 {
				frame-number = <0x03>;
				interrupts = <0x00 0x0b 0x04>;
				reg = <0xb025000 0x1000>;
				status = "disabled";
			};

			frame@b026000 {
				frame-number = <0x04>;
				interrupts = <0x00 0x0c 0x04>;
				reg = <0xb026000 0x1000>;
				status = "disabled";
			};

			frame@b027000 {
				frame-number = <0x05>;
				interrupts = <0x00 0x0d 0x04>;
				reg = <0xb027000 0x1000>;
				status = "disabled";
			};

			frame@b028000 {
				frame-number = <0x06>;
				interrupts = <0x00 0x0e 0x04>;
				reg = <0xb028000 0x1000>;
				status = "disabled";
			};
		};

		p8: power-manager@b088000 {
			compatible = "qcom,msm8916-acc";
			reg = <0xb088000 0x1000>;
			status = "reserved";
			phandle = <0x08>;
		};

		p9: power-manager@b089000 {
			compatible = "qcom,msm8916-saw2-v3.0-cpu", "qcom,saw2";
			reg = <0xb089000 0x1000>;
			status = "reserved";
			phandle = <0x09>;
		};

		pb: power-manager@b098000 {
			compatible = "qcom,msm8916-acc";
			reg = <0xb098000 0x1000>;
			status = "reserved";
			phandle = <0x0b>;
		};

		pc: power-manager@b099000 {
			compatible = "qcom,msm8916-saw2-v3.0-cpu", "qcom,saw2";
			reg = <0xb099000 0x1000>;
			status = "reserved";
			phandle = <0x0c>;
		};

		pe: power-manager@b0a8000 {
			compatible = "qcom,msm8916-acc";
			reg = <0xb0a8000 0x1000>;
			status = "reserved";
			phandle = <0x0e>;
		};

		pf: power-manager@b0a9000 {
			compatible = "qcom,msm8916-saw2-v3.0-cpu", "qcom,saw2";
			reg = <0xb0a9000 0x1000>;
			status = "reserved";
			phandle = <0x0f>;
		};

		p11: power-manager@b0b8000 {
			compatible = "qcom,msm8916-acc";
			reg = <0xb0b8000 0x1000>;
			status = "reserved";
			phandle = <0x11>;
		};

		p12: power-manager@b0b9000 {
			compatible = "qcom,msm8916-saw2-v3.0-cpu", "qcom,saw2";
			reg = <0xb0b9000 0x1000>;
			status = "reserved";
			phandle = <0x12>;
		};
	};

	thermal-zones {

		cpu0-1-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&pa6 0x05>;

			trips {

				pa7: trip-point0 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0xa7>;
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0xa7>;
					cooling-device = <&p3d 0xffffffff 0xffffffff &p3e 0xffffffff 0xffffffff &p3f 0xffffffff 0xffffffff &p40 0xffffffff 0xffffffff>;
				};
			};
		};

		cpu2-3-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&pa6 0x04>;

			trips {

				pa8: trip-point0 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0xa8>;
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0xa8>;
					cooling-device = <&p3d 0xffffffff 0xffffffff &p3e 0xffffffff 0xffffffff &p3f 0xffffffff 0xffffffff &p40 0xffffffff 0xffffffff>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&pa6 0x02>;

			trips {

				trip-point0 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				gpu-crit {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};

		camera-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&pa6 0x01>;

			trips {

				trip-point0 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "hot";
				};
			};
		};

		modem-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&pa6 0x00>;

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "hot";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x04 0xf08 0x01 0x01 0xf08>;
	};

	p56: battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <0x2dc6c0>;
		voltage-max-design-microvolt = <0x426030>;
		energy-full-design-microwatt-hours = <0x79c3e0>;
		charge-full-design-microamp-hours = <0x200b20>;
		ocv-capacity-celsius = <0x19>;
		ocv-capacity-table-0 = <0x426030 0x64 0x419ce0 0x62 0x40d990 0x60 0x401640 0x5e 0x3e8fa0 0x5a 0x3dcc50 0x57 0x3d0900 0x54 0x3c45b0 0x50 0x3b8260 0x4b 0x3abf10 0x46 0x39fbc0 0x41 0x393870 0x3c 0x387520 0x37 0x37b1d0 0x32 0x36ee80 0x2d 0x362b30 0x28 0x3567e0 0x23 0x34a490 0x1e 0x33e140 0x19 0x331df0 0x14 0x325aa0 0x0f 0x319750 0x0a 0x30d400 0x05 0x3010b0 0x03 0x2f4d60 0x01 0x2dc6c0 0x00>;
		phandle = <0x56>;
	};

	p9d: usb-id {
		compatible = "linux,extcon-usb-gpio";
		id-gpio = <&p49 0x6e 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0xa9>;
		phandle = <0x9d>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0xaa 0xac>;
		label = "GPIO Buttons";

		key-freset {
			label = "key_freset";
			gpios = <&p49 0x25 0x00>;
			linux,input-type = <0x01>;
			linux,code = <0xd8>;
			linux,can-wakeup;
			debounce-interval = <0x3c>;
		};

		key-wps {
			label = "key_wps";
			gpios = <&p49 0x1b 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x40>;
			linux,can-wakeup;
			debounce-interval = <0x3c>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <0xab>;
		pinctrl-names = "default";

		ftest {
			label = "ftest";
			gpios = <&p49 0x20 0x00>;
			linux,default-trigger = "none";
			default-state = "keep";
			retain-state-suspended;
		};

		wifistatus {
			label = "wifistatus";
			gpios = <&p49 0x49 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
		};

		led-4g-1 {
			label = "4g_1";
			gpios = <&p49 0x47 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
		};

		led-4g-2 {
			label = "4g_2";
			gpios = <&p49 0x46 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
		};

		led-4g-type {
			label = "4g_type";
			gpios = <&p49 0x48 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
		};

		esim1-en {
			label = "esim1_en";
			gpios = <&p49 0x77 0x00>;
			linux,default-trigger = "none";
			default-state = "keep";
			retain-state-suspended;
		};

		esim2-en {
			label = "esim2_en";
			gpios = <&p49 0x0e 0x00>;
			linux,default-trigger = "none";
			default-state = "keep";
			retain-state-suspended;
		};

		esim3-en {
			label = "esim3_en";
			gpios = <&p49 0x0c 0x00>;
			linux,default-trigger = "none";
			default-state = "keep";
			retain-state-suspended;
		};

		sim-hotplug {
			label = "sim_hotplug";
			gpios = <&p49 0x72 0x00>;
			linux,default-trigger = "none";
			default-state = "keep";
			retain-state-suspended;
		};

		bat-1 {
			label = "bat1";
			gpios = <&p49 0x00 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
		};

		bat-2 {
			label = "batl2";
			gpios = <&p49 0x5b 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
		};

		bat-3 {
			label = "batl3";
			gpios = <&p49 0x01 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
		};

		bat-4 {
			label = "batl4";
			gpios = <&p49 0x64 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
		};
	};
};
