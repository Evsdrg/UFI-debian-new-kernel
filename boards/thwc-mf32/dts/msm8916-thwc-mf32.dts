					drive-strength = <0x02>;
					bias-disable;
				};
			};

			ext-sec-tlmm-lines-state {

				tlmm-lines-on-pins {
					pins = "gpio112", "gpio117", "gpio118", "gpio119";
					function = "sec_mi2s";
					drive-strength = <0x08>;
					bias-disable;
				};

				tlmm-lines-off-pins {
					pins = "gpio112", "gpio117", "gpio118", "gpio119";
					function = "sec_mi2s";
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			cdc-dmic-lines-on-state {

				clk-pins {
					pins = "gpio0";
					function = "dmic0_clk";
					drive-strength = <0x08>;
				};

				data-pins {
					pins = "gpio1";
					function = "dmic0_data";
					drive-strength = <0x08>;
				};
			};

			cdc-dmic-lines-off-state {

				clk-pins {
					pins = "gpio0";
					function = "dmic0_clk";
					drive-strength = <0x02>;
					bias-disable;
				};

				data-pins {
					pins = "gpio1";
					function = "dmic0_data";
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			pa2: wcnss-active-state {
				pins = "gpio40", "gpio41", "gpio42", "gpio43", "gpio44";
				function = "wcss_wlan";
				drive-strength = <0x06>;
				bias-pull-up;
				phandle = <0xa2>;
			};

			p52: cci0-default-state {
				pins = "gpio29", "gpio30";
				function = "cci_i2c";
				drive-strength = <0x10>;
				bias-disable;
				phandle = <0x52>;
			};

			camera-front-default-state {

				pwdn-pins {
					pins = "gpio33";
					function = "gpio";
					drive-strength = <0x10>;
					bias-disable;
				};

				rst-pins {
					pins = "gpio28";
					function = "gpio";
					drive-strength = <0x10>;
					bias-disable;
				};

				mclk1-pins {
					pins = "gpio27";
					function = "cam_mclk1";
					drive-strength = <0x10>;
					bias-disable;
				};
			};

			camera-rear-default-state {

				pwdn-pins {
					pins = "gpio34";
					function = "gpio";
					drive-strength = <0x10>;
					bias-disable;
				};

				rst-pins {
					pins = "gpio35";
					function = "gpio";
					drive-strength = <0x10>;
					bias-disable;
				};

				mclk0-pins {
					pins = "gpio26";
					function = "cam_mclk0";
					drive-strength = <0x10>;
					bias-disable;
				};
			};

			paa: tlmm-gpio-key-active {
				pins = "gpio37";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0xaa>;
			};

			pac: tlmm-wps-gpio-key-active {
				pins = "gpio27";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0xac>;
			};

			pab: gpio-leds-default-state {
				function = "gpio";
				pins = "gpio70", "gpio71", "gpio72", "gpio73", "gpio0", "gpio1", "gpio91", "gpio100", "gpio14", "gpio12", "gpio119", "gpio114", "gpio32";
				drive-strength = <0x08>;
				bias-disable;
				phandle = <0xab>;
			};

			pa9: usb-id-default-state {
				function = "gpio";
				pins = "gpio110";
				drive-strength = <0x08>;
