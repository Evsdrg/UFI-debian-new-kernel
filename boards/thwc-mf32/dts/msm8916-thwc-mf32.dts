				assigned-clock-parents = <0x4e 0x00 0x4e 0x01>;
				clocks = <&p13 0x71 &p13 0x6d &p13 0x6e &p13 0x6f &p13 0x72 &p13 0x70>;
				clock-names = "mdp_core", "iface", "bus", "byte", "pixel", "core";
